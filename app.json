{
  "expo": {
    "name": "AgriTask",
    "slug": "agritask",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/prabhuseed.jpg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/prabhuseed.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pga.agritask",
      "config": {
        "googleMapsApiKey": "AIzaSyBhjuSxK3y5CbO9iEkHOTmZ0u_JC0ApeNc"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/prabhuseed.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pga.agritask",
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBhjuSxK3y5CbO9iEkHOTmZ0u_JC0ApeNc"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "agritask",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfd4d586-872e-4698-bdfd-6884ef9ddf40"
      }
    },
    "owner": "justkuldeep"
  }
}
