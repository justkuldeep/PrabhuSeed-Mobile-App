# API base URL — the only value you need to change per environment
#
# Local development (use your machine's LAN IP so physical devices can reach it):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
#
# Production (AWS / any cloud server):
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
